---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Merwan Birem — AI Innovation Leader. Computer Vision, Industrial AI & Autonomous Perception. 10+ years R&D experience, 20+ publications, leading 4M€ research programs at Flanders Make, Belgium.', wide = false } = Astro.props;

const B = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // always ends with /
const SITE = 'https://merwanski.github.io';
const CANONICAL = `${SITE}${Astro.url.pathname}`;
const PAGE_TITLE = title === 'Home' ? 'Merwan Birem' : `${title} — Merwan Birem`;

const nav = [
  { label: 'Now', href: `${B}now` },
  { label: 'Projects', href: `${B}projects` },
  { label: 'Papers', href: `${B}papers` },
  { label: 'Blog', href: `${B}blog` },
  { label: 'Milestones', href: `${B}milestones` },
  { label: 'Impossible List', href: `${B}impossible-list` },
  { label: 'Travels', href: `${B}travels` },
  { label: 'Contact', href: `${B}contact` },
];

const currentPath = Astro.url.pathname;
const containerClass = wide ? 'max-w-6xl' : 'max-w-3xl';

// JSON-LD Person schema — injected on every page so Google and LLMs
// can confidently associate this site with Merwan Birem.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Merwan Birem',
  url: `${SITE}${B}`,
  image: `${SITE}${B}og-image.png`,
  jobTitle: 'AI Innovation Leader & Senior Research Engineer',
  description: 'AI Innovation Leader with 10+ years of experience in computer vision, robotics, and industrial AI systems. Leading multi-million euro R&D programs at Flanders Make, Belgium.',
  worksFor: {
    '@type': 'Organization',
    name: 'Flanders Make',
    url: 'https://www.flandersmake.be',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Université Clermont Auvergne (Blaise Pascal)', address: { '@type': 'PostalAddress', addressCountry: 'FR' } },
    { '@type': 'CollegeOrUniversity', name: 'National Polytechnic School of Algiers', address: { '@type': 'PostalAddress', addressCountry: 'DZ' } },
  ],
  knowsAbout: ['Computer Vision', 'Visual SLAM', 'Deep Learning', 'Industrial AI', 'Sensor Fusion', 'Pose Estimation', 'Robotics', 'MLOps', 'AI Workflow Automation'],
  nationality: { '@type': 'Country', name: 'Algeria' },
  address: { '@type': 'PostalAddress', addressLocality: 'Sterrebeek', addressCountry: 'BE' },
  sameAs: [
    'https://www.linkedin.com/in/merwan-birem-600a593a/',
    'https://scholar.google.com/citations?user=oikUY4YAAAAJ',
    'https://github.com/Merwanski',
    'https://medium.com/@just-merwan',
    'https://github.com/Merwanski',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Merwan Birem" />
    <meta name="keywords" content="Merwan Birem, AI, Computer Vision, Visual SLAM, Industrial AI, Flanders Make, Research Engineer, Belgium, Deep Learning, Robotics" />
    <link rel="canonical" href={CANONICAL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL} />
    <meta property="og:title" content={PAGE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}${B}og-image.png`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Merwan Birem" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}${B}og-image.png`} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Apply the saved or system theme before first paint (no flash) -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <meta name="theme-color" content="#f5f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1730" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={`${B}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-md focus:bg-accent focus:text-on-accent">
      Skip to content
    </a>
    <div class="spotlight hidden" aria-hidden="true"></div>

    <header class="border-b border-border sticky top-0 bg-bg/85 backdrop-blur-md z-20">
      <div class={`${containerClass} mx-auto px-6 h-14 flex items-center justify-between gap-4`}>
        <a href={B} class="text-sm font-semibold tracking-tight text-ink hover:text-accent transition-colors">
          MB<span class="sr-only"> (Merwan Birem, home)</span>
        </a>

        <div class="flex items-center gap-2 md:gap-6">
          <nav aria-label="Main" class="hidden md:flex items-center gap-5">
            {nav.map(({ label, href }) => {
              const active = currentPath === href || (href !== '/' && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class={`text-sm transition-colors ${active ? 'text-accent font-medium' : 'text-muted hover:text-ink'}`}
                >
                  {label}
                </a>
              );
            })}
          </nav>

          <button
            type="button"
            id="theme-toggle"
            class="p-2 rounded-md text-muted hover:text-ink hover:bg-surface-2 transition-colors"
            aria-label="Switch between light and dark theme"
            title="Toggle theme"
          >
            <!-- moon (shown in light mode) -->
            <svg class="w-4 h-4 dark-hide" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M17.3 13.4A7.5 7.5 0 0 1 6.6 2.7a.6.6 0 0 0-.8-.7A8.75 8.75 0 1 0 18 14.2a.6.6 0 0 0-.7-.8Z"/></svg>
            <!-- sun (shown in dark mode) -->
            <svg class="w-4 h-4 light-hide" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.66 4.34a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 0 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM6.46 13.54a.75.75 0 0 1 0 1.06L5.4 15.66a.75.75 0 0 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.6 13.54a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 1 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06ZM5.4 4.34a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 0 1-1.06 1.06L5.4 5.4a.75.75 0 0 1 0-1.06Z"/></svg>
          </button>

          <!-- Small screens: menu -->
          <details class="md:hidden relative group/menu">
            <summary class="list-none cursor-pointer p-2 rounded-md text-muted hover:text-ink hover:bg-surface-2 transition-colors" aria-label="Menu">
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5A.75.75 0 0 1 2.75 9h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.75Zm0 5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"/></svg>
            </summary>
            <nav aria-label="Main" class="absolute right-0 mt-2 w-52 rounded-lg border border-border bg-surface shadow-lg p-2 flex flex-col">
              {nav.map(({ label, href }) => {
                const active = currentPath === href || (href !== '/' && currentPath.startsWith(href));
                return (
                  <a href={href} aria-current={active ? 'page' : undefined} class={`px-3 py-2 rounded-md text-sm ${active ? 'text-accent font-medium bg-accent-soft' : 'text-muted hover:text-ink hover:bg-surface-2'}`}>
                    {label}
                  </a>
                );
              })}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class={`relative z-10 flex-1 ${containerClass} mx-auto w-full px-6 py-14`}>
      <slot />
    </main>

    <footer class="relative z-10 border-t border-border mt-auto">
      <div class={`${containerClass} mx-auto px-6 py-8 flex flex-wrap gap-2 items-center justify-between text-xs text-faint`}>
        <span>© {new Date().getFullYear()} Merwan Birem</span>
        <span>Built with Astro · Hosted on GitHub Pages</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Cursor spotlight on devices with a fine pointer, unless reduced motion is requested
      const spot = document.querySelector<HTMLElement>('.spotlight');
      if (spot && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        spot.classList.remove('hidden');
        window.addEventListener('pointermove', e => {
          spot.style.setProperty('--spot-x', `${e.clientX}px`);
          spot.style.setProperty('--spot-y', `${e.clientY}px`);
        }, { passive: true });
      }
    </script>

  </body>
</html>
