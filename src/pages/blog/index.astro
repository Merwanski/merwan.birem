---
import Layout from '../../layouts/Layout.astro';
import cachedPosts from '../../data/medium-posts.json';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const USERNAME    = 'just-merwan';
const PROFILE_URL = `https://medium.com/@${USERNAME}`;
const RSS_URL     = `https://medium.com/feed/@${USERNAME}`;

interface Post {
  title: string;
  url: string;
  date: string;
  summary: string;
  tags: string[];
  readingTime?: string | null;
  image?: string | null;
}

function parseMediumRSS(xml: string): Post[] {
  const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)];
  return items.map(([, item]) => {
    const title =
      item.match(/<title><!\[CDATA\[([\s\S]*?)\]\]>/)?.[1]?.trim() ??
      item.match(/<title>([\s\S]*?)<\/title>/)?.[1]?.trim() ?? '';
    const rawUrl =
      item.match(/<link>(https?:\/\/[^<\s]+)<\/link>/)?.[1] ??
      item.match(/<guid[^>]*>(https?:\/\/[^<\s]+)<\/guid>/)?.[1] ?? '';
    const url = rawUrl.split('?')[0];
    const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1] ?? '';
    const date    = pubDate ? new Date(pubDate).toISOString().split('T')[0] : '';
    const tags    = [...item.matchAll(/<category><!\[CDATA\[(.*?)\]\]>/g)].map(m => m[1]).slice(0, 4);
    const rawDesc = item.match(/<description><!\[CDATA\[([\s\S]*?)\]\]>/)?.[1] ?? '';
    const stripped = rawDesc
      .replace(/<[^>]+>/g, '')
      .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#x[\da-f]+;/gi, c => String.fromCharCode(parseInt(c.slice(3, -1), 16)))
      .replace(/Continue reading on Medium\s*[»›]?/gi, '')
      .replace(/\s+/g, ' ').trim();
    const summary  = stripped.slice(0, 220) + (stripped.length > 220 ? '…' : '');
    const readingMatch = rawDesc.match(/(\d+)\s*min\s*read/i);
    return { title, url, date, summary, tags, readingTime: readingMatch ? `${readingMatch[1]} min` : null };
  }).filter(p => p.title && p.url);
}

// Use the synced JSON as primary source; fall back to live RSS if empty
let posts: Post[] = cachedPosts as Post[];
let liveError = false;

if (posts.length === 0) {
  try {
    const res = await fetch(RSS_URL, {
      headers: { 'User-Agent': 'MerwanBirem-site/1.0' },
    });
    if (res.ok) posts = parseMediumRSS(await res.text());
    else liveError = true;
  } catch {
    liveError = true;
  }
}

const synced = (cachedPosts as Post[]).length > 0;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Site posts (full articles) first; Medium-only posts from the RSS sync fill in the rest.
const mediumId = (url: string) => url.split('?')[0].replace(/\/$/, '').split('-').pop() ?? url;
const sitePosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const onSite = new Set(sitePosts.filter(p => p.data.medium_url).map(p => mediumId(p.data.medium_url)));
const MEDIUM_ONLY = 'More on Medium';
const items = [
  ...sitePosts.map(p => ({
    key: p.id, title: p.data.title, href: `${B}blog/${p.id}/`, external: false,
    date: p.data.date.toISOString().slice(0, 10), summary: p.data.summary || p.data.subtitle,
    tags: p.data.tags.slice(0, 4), category: p.data.category, hero: p.data.hero ?? p.data.thumb, heroAlt: p.data.hero_alt,
    image: null as string | null, readingTime: null as string | null,
  })),
  ...posts.filter(p => !onSite.has(mediumId(p.url))).map(p => ({
    key: p.url, title: p.title, href: p.url, external: true, date: p.date, summary: p.summary,
    tags: p.tags, category: MEDIUM_ONLY, hero: undefined, heroAlt: '', image: p.image ?? null, readingTime: p.readingTime ?? null,
  })),
].sort((a, b) => b.date.localeCompare(a.date));
const categories = [...new Set(items.map(i => i.category))].sort((a, b) =>
  a === MEDIUM_ONLY ? 1 : b === MEDIUM_ONLY ? -1 : a.localeCompare(b));
---

<Layout title="Blog" description="Writing by Merwan Birem — research notes, engineering deep-dives, and reflections.">

  <div class="mb-8">
    <h1 class="text-2xl font-semibold tracking-tight mb-2">Blog</h1>
    <p class="text-[var(--color-muted)]">
      Research notes, engineering deep-dives and book summaries. Also on{' '}
      <a href={PROFILE_URL} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">
        Medium</a>.
    </p>
  </div>

  {/* Sync status badge */}
  <div class="flex items-center justify-between mb-8">
    <p class="text-xs text-[var(--color-faint)]">
      {`${sitePosts.length} full article${sitePosts.length !== 1 ? 's' : ''} on this site`}
      {synced ? ' · latest Medium posts synced' : ' · live from Medium RSS'}
    </p>
    <a
      href={PROFILE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs text-[var(--color-accent)] hover:underline"
    >
      View on Medium →
    </a>
  </div>

  {items.length === 0 ? (
    <p class="text-[var(--color-muted)] text-sm italic">
      {liveError
        ? 'Could not load posts right now — try again later.'
        : 'No posts published yet.'}
    </p>
  ) : (
    <>
      <div class="flex flex-wrap gap-2 mb-8" role="toolbar" aria-label="Filter articles by category">
        <button type="button" data-filter="all" aria-pressed="true" class="chip">All <span class="opacity-60 ml-1">{items.length}</span></button>
        {categories.map(c => (
          <button type="button" data-filter={c} aria-pressed="false" class="chip">
            {c} <span class="opacity-60 ml-1">{items.filter(i => i.category === c).length}</span>
          </button>
        ))}
      </div>

      <ul class="focus-list space-y-4" id="post-list">
        {items.map(item => (
          <li class="-mx-4 p-4" data-category={item.category}>
            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}
               class="group flex flex-col sm:flex-row gap-4">
              <div class="sm:w-44 shrink-0">
                {item.hero ? (
                  <Image src={item.hero} alt={item.heroAlt} width={352} class="w-full aspect-[16/10] object-cover rounded-md border border-[var(--color-border)]" />
                ) : item.image ? (
                  <img src={item.image} alt="" loading="lazy" decoding="async" class="w-full aspect-[16/10] object-cover rounded-md border border-[var(--color-border)]" />
                ) : (
                  <div class="w-full aspect-[16/10] rounded-md border border-[var(--color-border)] bg-surface-2"></div>
                )}
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3 mb-1.5">
                  {item.date && (
                    <time class="text-xs text-[var(--color-faint)] font-mono">
                      {new Date(item.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </time>
                  )}
                  <span class="text-xs text-[var(--color-accent)]">{item.category}</span>
                  {item.readingTime && <span class="text-xs text-[var(--color-faint)]">{item.readingTime} read</span>}
                </div>
                <h2 class="text-base font-medium group-hover:text-[var(--color-accent)] transition-colors mb-1">
                  {item.title}
                  {item.external && <span class="text-xs opacity-50 ml-1">↗</span>}
                </h2>
                {item.summary && <p class="text-sm text-[var(--color-muted)] leading-relaxed">{item.summary}</p>}
                {item.tags.length > 0 && (
                  <div class="flex gap-2 mt-2 flex-wrap">
                    {item.tags.map(tag => <span class="text-xs px-2 py-0.5 bg-surface-2 text-muted rounded-full">{tag}</span>)}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLLIElement>('#post-list > li');
    chips.forEach(chip => chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
      rows.forEach(r => { r.hidden = f !== 'all' && r.dataset.category !== f; });
    }));
  </script>

  <style>
    .chip {
      font-size: 0.8rem; padding: 0.3rem 0.8rem; border-radius: 999px; cursor: pointer;
      border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-muted);
      transition: border-color .15s, color .15s, background .15s;
    }
    .chip:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .chip[aria-pressed="true"] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  </style>

</Layout>
