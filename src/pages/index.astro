---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPapers = await getCollection('papers');
const papers = allPapers.filter(({ data }) => data.featured);
const milestones = (await getCollection('milestones', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const sortedPapers = papers.sort((a, b) => b.data.year - a.data.year);

const skills = {
  core: ['Computer Vision (2D/3D)', 'Visual SLAM', 'Sensor Fusion', 'Deep Learning', 'Pose Estimation', 'Object Detection', 'Quality Monitoring', 'AR/VR for Industry'],
  tools: ['Python', 'OpenCV', 'Open3D', 'ROS2', 'PyTorch', 'Docker', 'CI/CD', 'MLOps', 'C/C++', 'VHDL', 'MATLAB', 'Git'],
  emerging: ['AI Workflow Automation (n8n)', 'AI Agents', 'LLM Applications', 'MCP'],
};

const experience = [
  {
    title: 'Project Leader & Senior Research Engineer – AI Innovation',
    org: 'Flanders Make',
    period: 'Apr 2022 – Present',
    location: 'Leuven, Belgium',
    highlights: [
      'Lead large-scale AI R&D programs including the 4M€ ALARMM SBO project (4 research groups, 7 industrial partners)',
      'Manage cross-functional teams of 3–12 across academia, industry, and public research',
      'Drive AI systems development in computer vision, visual SLAM, and sensor fusion for industrial environments',
      '4× technology transfer from research to industry in the most recent completed project (2025)',
      'Full lifecycle ownership: opportunity scouting, consortium building, proposal writing, technical execution',
    ],
  },
  {
    title: 'Research Engineer – Computer Vision & AI',
    org: 'Flanders Make',
    period: 'Jan 2018 – Mar 2022',
    location: 'Leuven, Belgium',
    highlights: [
      'Designed AI-based vision systems for industrial inspection and automation',
      'Applied deep learning and self-supervised learning for real-time perception systems',
      'Contributed to EU-funded project proposals and technical work packages',
    ],
  },
  {
    title: 'Research Engineer – Intelligent Vehicles',
    org: "Flanders' DRIVE",
    period: 'May 2015 – Dec 2017',
    location: 'Lommel, Belgium',
    highlights: [],
  },
  {
    title: 'PhD Researcher – Embedded Vision for Robotics',
    org: 'Institut Pascal',
    period: '2011 – 2015',
    location: 'Clermont-Ferrand, France',
    highlights: [],
  },
];

const education = [
  { degree: 'PhD · Electronics & System Architecture', institution: 'Blaise Pascal University', year: '2011–2015', location: 'France' },
  { degree: 'MSc · Robotics & Multisensory Perception', institution: 'Blaise Pascal University', year: '2010–2011', location: 'France' },
  { degree: 'Engineering · Electronics', institution: 'National Polytechnic School', year: '2005–2010', location: 'Algeria' },
];

const languages = [
  { name: 'English', level: 5 },
  { name: 'French', level: 5 },
  { name: 'Arabic', level: 5 },
  { name: 'Dutch', level: 3 },
];

// Key projects live in src/content/projects/ (featured: true), each with a detail page
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .map(p => ({
    title: p.data.name,
    period: p.data.years,
    description: p.data.description,
    tags: p.data.tags,
    slug: p.id,
    cover: p.data.gallery[0]?.src ?? (p.data.youtube ? `https://i.ytimg.com/vi/${p.data.youtube}/mqdefault.jpg` : undefined),
  }));

const sections = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'publications', label: 'Publications' },
  { id: 'milestones', label: 'Milestones' },
  { id: 'background', label: 'Background' },
];

const B = import.meta.env.BASE_URL.replace(/\/?$/, '/'); // always ends with /
const asset = (p: string) => (p.startsWith('http') ? p : `${B}${p.replace(/^\//, '')}`);

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/merwan-birem-600a593a/' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=oikUY4YAAAAJ' },
  { label: 'GitHub', href: 'https://github.com/Merwanski' },
  { label: 'Medium', href: 'https://medium.com/@just-merwan' },
  { label: 'CV', href: `${B}cv/Merwan_Birem_CV.pdf` },
];

const explore = [
  { label: 'Now', href: `${B}now` },
  { label: 'Travels', href: `${B}travels` },
  { label: 'Impossible List', href: `${B}impossible-list` },
  { label: 'Blog', href: `${B}blog` },
];

const fmtMilestone = (d: Date, precision: string) =>
  d.toLocaleDateString('en-GB', precision === 'year' ? { year: 'numeric' } : { month: 'short', year: 'numeric' });
---

<Layout title="Home" wide={true}>
  <div class="lg:flex lg:justify-between lg:gap-16">

    <!-- ── LEFT: identity + section nav (sticky on large screens) ── -->
    <header class="lg:sticky lg:top-14 lg:flex lg:h-[calc(100vh-3.5rem)] lg:w-[42%] lg:flex-col lg:justify-between lg:-mt-14 lg:py-20">
      <div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">Merwan Birem</h1>
        <p class="mt-3 text-lg font-medium text-ink">AI Innovation Leader</p>
        <p class="mt-4 max-w-sm leading-relaxed text-muted">
          Computer vision, industrial AI and autonomous perception, from research to the factory floor.
        </p>
        <p class="mt-2 text-sm text-faint">Sterrebeek, Belgium · Flanders Make</p>

        <nav class="hidden lg:block mt-14" aria-label="On this page">
          <ul class="w-max">
            {sections.map(({ id, label }) => (
              <li>
                <a href={`#${id}`} data-section-link={id} class="group flex items-center py-2.5">
                  <span class="mr-4 h-px w-8 bg-faint transition-all group-hover:w-16 group-hover:bg-ink group-[.active]:w-16 group-[.active]:bg-accent motion-reduce:transition-none"></span>
                  <span class="text-xs font-bold uppercase tracking-widest text-faint group-hover:text-ink group-[.active]:text-accent">{label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="mt-8 lg:mt-0 space-y-4">
        <ul class="flex flex-wrap gap-2" aria-label="Profiles">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm px-3 py-1.5 rounded-full border border-border text-muted hover:text-accent hover:border-accent transition-colors">
                {label} <span aria-hidden="true" class="text-xs">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="text-sm text-faint">
          Also:{' '}
          {explore.map(({ label, href }, i) => (
            <>{i > 0 && ' · '}<a href={href} class="text-muted hover:text-accent transition-colors">{label}</a></>
          ))}
        </p>
      </div>
    </header>

    <!-- ── RIGHT: scrolling content ── -->
    <div class="pt-20 lg:w-[58%] lg:pt-6 space-y-24">

      <section id="about" class="scroll-mt-20" aria-label="About">
        <h2 class="section-title">About</h2>
        <div class="space-y-4 leading-relaxed text-muted">
          <p>
            I'm an <strong class="text-ink font-medium">AI innovation leader</strong> with more than 10 years in computer vision,
            robotics and industrial AI. I lead multi-million euro R&amp;D programmes (4M€+) at Flanders Make and take applied AI
            from research all the way to industrial deployment.
          </p>
          <p>
            My focus is perception: <strong class="text-ink font-medium">visual SLAM</strong>, AI-driven quality inspection and
            pose estimation. Right now that means markerless, centimetre-level localisation for factories in
            <a href={`${B}projects/alarmm`} class="text-accent hover:underline">ALARMM</a>, and AR and human–robot collaboration for
            construction sites in <a href={`${B}projects/robocons`} class="text-accent hover:underline">ROBOCONS</a>.
          </p>
          <p>
            I'm also exploring AI systems engineering, MLOps and workflow automation, to bridge advanced research and
            scalable real-world deployment.
          </p>
        </div>
      </section>

      <section id="projects" class="scroll-mt-20" aria-label="Key projects">
        <h2 class="section-title">Projects</h2>
        <ul class="group/list space-y-4">
          {projects.map(p => (
            <li>
              <a href={`${B}projects/${p.slug}`} class="card group">
                {p.cover && (
                  <img src={asset(p.cover)} alt="" loading="lazy" decoding="async" class="sm:col-span-2 order-2 sm:order-1 w-40 sm:w-full aspect-video object-cover rounded border border-border bg-surface transition group-hover:border-accent/40" />
                )}
                <div class={`order-1 sm:order-2 ${p.cover ? 'sm:col-span-6' : 'sm:col-span-8'}`}>
                  <h3 class="font-medium leading-snug text-ink group-hover:text-accent transition-colors">
                    {p.title} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
                  </h3>
                  <p class="mt-1 text-xs font-mono text-faint">{p.period}</p>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
                  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">
                    {p.tags.map(t => <li class="chip">{t}</li>)}
                  </ul>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href={`${B}projects`} class="more-link">All projects</a>
      </section>

      <section id="experience" class="scroll-mt-20" aria-label="Experience">
        <h2 class="section-title">Experience</h2>
        <ol class="group/list space-y-4">
          {experience.map(role => (
            <li class="card cursor-default">
              <p class="sm:col-span-2 mt-1 text-xs font-semibold uppercase tracking-wide text-faint">{role.period}</p>
              <div class="sm:col-span-6">
                <h3 class="font-medium leading-snug text-ink">{role.title} <span class="text-accent">· {role.org}</span></h3>
                <p class="mt-1 text-xs text-faint">{role.location}</p>
                {role.highlights.length > 0 && (
                  <ul class="mt-3 space-y-1.5">
                    {role.highlights.map(h => (
                      <li class="flex items-start gap-2 text-sm leading-relaxed text-muted">
                        <span class="mt-2 w-1 h-1 rounded-full bg-faint shrink-0" aria-hidden="true"></span>
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
        <a href={`${B}cv/Merwan_Birem_CV.pdf`} target="_blank" rel="noopener noreferrer" class="more-link">Full CV (PDF)</a>
      </section>

      <section id="publications" class="scroll-mt-20" aria-label="Selected publications">
        <h2 class="section-title">Publications</h2>
        <ul class="group/list space-y-4">
          {sortedPapers.map(paper => (
            <li>
              <a href={`${B}papers/${paper.id}`} class="card group">
                {(paper.data.figure ?? paper.data.thumbnail) && (
                  <img src={asset((paper.data.figure ?? paper.data.thumbnail)!)} alt="" loading="lazy" decoding="async" class="sm:col-span-2 order-2 sm:order-1 w-32 sm:w-full aspect-[4/3] object-contain rounded border border-border bg-white p-1 transition group-hover:border-accent/40" />
                )}
                <div class="order-1 sm:order-2 sm:col-span-6">
                  <h3 class="font-medium leading-snug text-ink group-hover:text-accent transition-colors">{paper.data.title}</h3>
                  <p class="mt-1 text-xs text-faint">
                    {paper.data.year}{paper.data.venue && ` · ${paper.data.venue}`}
                  </p>
                  {paper.data.citations != null && paper.data.citations > 0 && (
                    <p class="mt-2 text-xs font-mono text-muted">{paper.data.citations} citations</p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href={`${B}papers`} class="more-link">All {allPapers.length} papers</a>
      </section>

      {milestones.length > 0 && (
        <section id="milestones" class="scroll-mt-20" aria-label="Recent milestones">
          <h2 class="section-title">Milestones</h2>
          <ol class="space-y-4">
            {milestones.map(m => (
              <li class="grid sm:grid-cols-8 gap-1 sm:gap-4">
                <span class="sm:col-span-2 text-xs font-mono text-faint pt-0.5">{fmtMilestone(m.data.date, m.data.precision)}</span>
                <span class="sm:col-span-6 text-sm leading-relaxed text-muted"><strong class="font-medium text-ink">{m.data.title}.</strong> {m.data.summary}</span>
              </li>
            ))}
          </ol>
          <a href={`${B}milestones`} class="more-link">All milestones</a>
        </section>
      )}

      <section id="background" class="scroll-mt-20" aria-label="Background">
        <h2 class="section-title">Background</h2>
        <div class="grid sm:grid-cols-2 gap-10">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-faint mb-4">Education</h3>
            <ul class="space-y-3">
              {education.map(e => (
                <li>
                  <p class="text-sm font-medium text-ink leading-snug">{e.degree}</p>
                  <p class="text-xs text-faint mt-0.5">{e.institution} · {e.year} · {e.location}</p>
                </li>
              ))}
            </ul>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-faint mt-8 mb-4">Languages</h3>
            <ul class="space-y-2.5 max-w-56">
              {languages.map(({ name, level }) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="text-sm text-muted">{name}</span>
                  <span class="flex gap-1" role="img" aria-label={`${level} out of 5`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span class={`w-2 h-2 rounded-full ${i < level ? 'bg-accent' : 'bg-border'}`} />
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div class="space-y-5">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-faint mb-3">AI &amp; perception</h3>
              <ul class="flex flex-wrap gap-1.5">{skills.core.map(s => <li class="chip chip-accent">{s}</li>)}</ul>
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-faint mb-3">Tools</h3>
              <ul class="flex flex-wrap gap-1.5">{skills.tools.map(s => <li class="chip">{s}</li>)}</ul>
            </div>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-faint mb-3">Learning now</h3>
              <ul class="flex flex-wrap gap-1.5">{skills.emerging.map(s => <li class="chip border border-dashed border-border bg-transparent">{s}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <blockquote class="border-l-2 border-accent/40 pl-5">
        <p class="italic text-muted leading-relaxed">"Life is like riding a bicycle. To keep your balance, you must keep moving."</p>
        <footer class="text-xs text-faint mt-2">Albert Einstein</footer>
      </blockquote>
    </div>
  </div>
</Layout>

<script>
  // Highlight the section-nav entry for the section currently in view
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')].map(a => [a.dataset.sectionLink!, a]),
  );
  const observer = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach(a => a.classList.remove('active'));
        links.get(entry.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
