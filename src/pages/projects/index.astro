---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

interface Project {
  name: string;
  years: string;
  description: string;
  tags: string[];
  slug?: string; // has a detail page in src/content/projects/
  cover?: string;
}

// Projects with a detail page come from src/content/projects/; list them here by id to keep the order.
const detailed = new Map((await getCollection('projects')).map(p => [p.id, p]));
const fromCollection = (id: string): Project => {
  const p = detailed.get(id);
  if (!p) throw new Error(`Unknown project "${id}" in src/pages/projects/index.astro`);
  return { ...p.data, slug: p.id, cover: p.data.gallery[0]?.src ?? (p.data.youtube ? `https://i.ytimg.com/vi/${p.data.youtube}/mqdefault.jpg` : undefined) };
};

const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (p: string) => (p.startsWith('http') ? p : `${B}${p.replace(/^\//, '')}`);

const projects: Project[] = [
  fromCollection('alarmm'),
  fromCollection('robocons'),
  fromCollection('qualma'),
  {
    name: 'RETAIN VILICON',
    years: '2024 – 2025',
    description: 'Details to be added.',
    tags: [],
  },
  fromCollection('frogs-cad2graspmonitor'),
