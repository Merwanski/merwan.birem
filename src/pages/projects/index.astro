---

<Layout title="Projects" description="Project portfolio of Merwan Birem — research and industrial AI projects from 2015 to present.">

  <div class="mb-10">
    <h1 class="text-2xl font-semibold tracking-tight mb-2">Projects</h1>
    <p class="text-[var(--color-muted)]">
      Research and industrial AI projects — 2015 to present.
      Details are being added progressively.
    </p>
  </div>

  <p class="text-xs font-medium uppercase tracking-widest text-[var(--color-faint)] mb-6">
    {projects.length} projects
  </p>

  <ul class="space-y-4">
    {projects.map(({ name, years, description, tags, slug, cover }) => (
      <li class="group relative rounded-xl border border-[var(--color-border)] px-6 py-5 hover:border-zinc-300 transition-colors">
        <div class="flex gap-5">
          {cover && (
            <img src={asset(cover)} alt="" loading="lazy" decoding="async" class="hidden sm:block shrink-0 w-28 h-20 object-cover rounded-md border border-[var(--color-border)] bg-white" />
          )}
          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h2 class="text-sm font-semibold text-[var(--color-ink)] leading-snug">
                {slug ? (
                  <a href={`${B}projects/${slug}`} class="group-hover:text-[var(--color-accent)] transition-colors after:absolute after:inset-0">{name}</a>
                ) : name}
              </h2>
              <span class="shrink-0 text-xs font-mono text-[var(--color-faint)] pt-0.5">{years}</span>
            </div>
            <p class={`text-sm leading-relaxed mb-3 ${description === 'Details to be added.' ? 'text-[var(--color-faint)] italic' : 'text-[var(--color-accent)]'}`}>
              {description}
            </p>
            {tags.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                {tags.map(tag => (
                  <span class="text-xs px-2.5 py-0.5 bg-zinc-100 text-zinc-500 rounded-full">{tag}</span>
                ))}
                {slug && <span class="ml-auto text-xs text-[var(--color-accent)]">Details →</span>}
              </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>

</Layout>
