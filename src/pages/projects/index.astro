  {
    name: 'Vision-Coock',
    years: '2022',
    description: 'Details to be added.',
    tags: [],
  },
  {
    name: 'DRONE-AI',
    years: '2021 – 2022',
    description: 'Details to be added.',
    tags: [],
  },
  {
    name: 'PILS',
    years: '2021',
    description: 'Details to be added.',
    tags: [],
  },
  {
    name: 'Product Counting',
    years: '2021',
    description: 'Details to be added.',
    tags: [],
  },
  {
    name: 'Box Counting v2',
    years: '2021',
    description: 'Details to be added.',
    tags: [],
  },
  {
    name: 'FAMAR',
    years: '2019 – 2021',
    description: 'Details to be added.',
    tags: [],
