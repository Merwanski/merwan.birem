---
// Horizontal, clickable overview of the milestones. Each milestone is a droplet
// (flag, logo, symbol or initials inside, ringed in its category colour) whose
// tip points at its date on the line. Droplets use both sides of the line and
// stack outwards only when they would collide. Each one links to its list entry.
import type { CollectionEntry } from 'astro:content';

interface Props {
  milestones: CollectionEntry<'milestones'>[];
  dotColors: Record<string, string>;
  formatDate: (m: CollectionEntry<'milestones'>) => string;
}

const { milestones, dotColors, formatDate } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Heroicons (MIT), 24×24 outline paths
const ICONS: Record<string, string> = {
  paper: 'M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z',
  degree: 'M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5',
  globe: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
  rocket: 'M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z',
  factory: 'M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z',
};

const badge = (icon?: string) => {
  if (!icon) return null;
  const [kind, ...rest] = icon.split(':');
  return { kind, value: rest.join(':') };
};

const asc = [...milestones].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const firstYear = asc[0].data.date.getFullYear();
const lastYear = asc[asc.length - 1].data.date.getFullYear();
const start = new Date(firstYear, 0, 1).getTime();
const end = new Date(lastYear + 1, 0, 1).getTime();
const pos = (d: Date) => ((d.getTime() - start) / (end - start)) * 100;

// Droplet geometry (px): a DROP-sized square with one sharp corner, rotated so
// the corner points at the line. TIP = distance from its centre to that corner.
const DROP = 30;
const TIP = DROP / Math.SQRT2;
const STEM = 8; // shortest stem between tip and line
const LANE = 36; // extra stem per stacked lane
const MIN_GAP = 5; // percent of track width two droplets on one side need

// Place each droplet on the side (up/down) and lane closest to the line
const ends = { up: [] as number[], down: [] as number[] };
let prefer: 'up' | 'down' = 'up';
const dots = asc.map((m) => {
  const x = pos(m.data.date);
  const free = (side: 'up' | 'down') => {
    const lane = ends[side].findIndex((e) => x - e >= MIN_GAP);
    return lane === -1 ? ends[side].length : lane;
  };
  const other = prefer === 'up' ? 'down' : 'up';
  const side = free(prefer) <= free(other) ? prefer : other;
  const lane = free(side);
  ends[side][lane] = x;
  prefer = side === 'up' ? 'down' : 'up'; // alternate when there is room
  const offset = STEM + lane * LANE + TIP; // line → droplet centre
  return { m, x, side, lane, offset, b: badge(m.data.icon) };
});

const TOOLTIP_ROOM = 28;
const extent = (side: 'up' | 'down') =>
  Math.max(0, ...dots.filter((d) => d.side === side).map((d) => d.offset + DROP / 2)) + TOOLTIP_ROOM;
const top = extent('up');
const height = top + extent('down');

const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const categories = [...new Set(asc.map((m) => m.data.category))];
---

<section aria-label="Timeline overview" class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 mb-12">
  <div class="overflow-x-auto">
    <div class="relative min-w-[520px] mx-4" style={`height: ${height}px`}>
      <!-- the line, with a tick per year -->
      <div class="absolute inset-x-0 h-px bg-[var(--color-border)]" style={`top: ${top}px`}></div>
      {years.map((y) => (
        <span class="absolute w-px h-2 -translate-y-1/2 bg-[var(--color-border)]" style={`left: ${pos(new Date(y, 0, 1))}%; top: ${top}px`} aria-hidden="true"></span>
      ))}

      {dots.map(({ m, x, side, offset, b }) => {
        const up = side === 'up';
        return (
          <a
            href={`#${m.id}`}
            class="group absolute -translate-x-1/2 -translate-y-1/2 rounded-full focus-visible:outline-offset-4"
            style={`left: ${x}%; top: ${top + (up ? -offset : offset)}px; width: ${DROP}px; height: ${DROP}px`}
            aria-label={`${formatDate(m)}: ${m.data.title}`}
          >
            <!-- stem from the droplet's tip to the line, and the dot on the line -->
            <span class="absolute left-1/2 w-px -translate-x-1/2 bg-[var(--color-border)] group-hover:bg-accent"
              style={`${up ? 'top' : 'bottom'}: calc(50% + ${TIP - 1}px); height: ${offset - TIP + 1}px`} aria-hidden="true"></span>
            <span class={`absolute left-1/2 w-1.5 h-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full ${dotColors[m.data.category] ?? 'bg-[var(--color-faint)]'}`}
              style={`top: calc(50% + ${up ? offset : -offset}px)`} aria-hidden="true"></span>

            <span class={`absolute inset-0 transition-transform duration-200 group-hover:scale-125 group-focus-visible:scale-125 ${up ? 'origin-bottom' : 'origin-top'}`}>
              <span class={`absolute inset-0 shadow-md ${dotColors[m.data.category] ?? 'bg-[var(--color-faint)]'}`}
                style={`border-radius: 50% 50% 50% 0; transform: rotate(${up ? -45 : 135}deg)`} aria-hidden="true"></span>
              <span class="absolute inset-[3px] flex items-center justify-center rounded-full overflow-hidden bg-[var(--color-surface)] text-[var(--color-ink)]">
                {b?.kind === 'flag' && <img src={`${B}flags/${b.value}.svg`} alt="" width="24" height="24" class="w-full h-full object-cover" />}
                {b?.kind === 'logo' && <img src={`${B}milestones/logos/${b.value}`} alt="" width="24" height="24" class="w-full h-full object-contain bg-white p-0.5" />}
                {b?.kind === 'icon' && ICONS[b.value] && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true"><path d={ICONS[b.value]} /></svg>
                )}
                {b?.kind === 'text' && <span class="text-[8px] font-bold leading-none tracking-tight">{b.value}</span>}
              </span>
            </span>

            <span class={`pointer-events-none absolute ${up ? 'bottom-full mb-2' : 'top-full mt-2'} w-max max-w-[14rem] ${x < 25 ? 'left-0' : x > 75 ? 'right-0' : 'left-1/2 -translate-x-1/2'} rounded-md bg-surface-2 border border-[var(--color-border)] px-2 py-1 text-xs text-[var(--color-ink)] shadow-lg opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity z-10`}>
              <span class="font-mono text-[var(--color-faint)]">{formatDate(m)}</span> · {m.data.title}
            </span>
          </a>
        );
      })}

      <!-- year labels along the bottom -->
      <div class="absolute inset-x-0 bottom-0 h-4" aria-hidden="true">
        {years.map((y) => (
          <span class="absolute -translate-x-1/2 text-[10px] font-mono text-[var(--color-faint)]" style={`left: ${pos(new Date(y, 6, 1))}%`}>{y}</span>
        ))}
      </div>
    </div>
  </div>
  <ul class="flex flex-wrap gap-4 mt-3 text-xs text-[var(--color-muted)]">
    {categories.map((c) => (
      <li class="flex items-center gap-1.5">
        <span class={`w-2.5 h-2.5 rounded-full ${dotColors[c]}`}></span>{c}
      </li>
    ))}
  </ul>
</section>
