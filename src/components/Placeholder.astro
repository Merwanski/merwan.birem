---
/**
 * "Under construction" stand-in for media or content still to come.
 * Every use is listed in GitHub issue "Content to provide for placeholders",
 * so replace it with the real image/video when it arrives.
 */
interface Props {
  /** What will go here, e.g. "ALARMM result videos" */
  label: string;
  kind?: 'image' | 'video' | 'photo';
  /** Shape of the box */
  aspect?: 'video' | 'square' | 'portrait' | 'wide';
  /** Compact version for thumbnails in lists */
  compact?: boolean;
  class?: string;
}

const { label, kind = 'image', aspect = 'video', compact = false, class: className = '' } = Astro.props;

const aspectClass = {
  video: 'aspect-video',
  square: 'aspect-square',
  portrait: 'aspect-[4/5]',
  wide: 'aspect-[3/1]',
}[aspect];
---

<div
  role="img"
  aria-label={`${label}: under construction, will be updated soon`}
  class:list={[
    'placeholder relative flex flex-col items-center justify-center text-center rounded-lg border border-dashed border-accent/40 overflow-hidden',
    aspectClass,
    compact ? 'p-1 gap-0.5' : 'p-4 gap-2',
    className,
  ]}
>
  {kind === 'video' ? (
    <svg class={compact ? 'w-5 h-5' : 'w-9 h-9'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="5" width="14" height="14" rx="2" />
      <path d="M17 10l4-2.5v9L17 14" stroke-linejoin="round" />
      <path d="M9 9.5v5l4-2.5-4-2.5Z" fill="currentColor" stroke="none" />
    </svg>
  ) : kind === 'photo' ? (
    <svg class={compact ? 'w-5 h-5' : 'w-9 h-9'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="9" r="3.5" />
      <path d="M5 19.5c1.2-3.2 3.9-5 7-5s5.8 1.8 7 5" stroke-linecap="round" />
    </svg>
  ) : (
    <svg class={compact ? 'w-5 h-5' : 'w-9 h-9'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <circle cx="9" cy="9.5" r="1.8" />
      <path d="M3.5 17.5l5-5 4 4 3-3 5 5" stroke-linejoin="round" />
    </svg>
  )}
  {compact ? (
    <span class="text-[10px] leading-tight font-medium">Coming soon</span>
  ) : (
    <>
      <span class="text-xs font-semibold uppercase tracking-wider">Under construction · will be updated soon</span>
      <span class="text-xs text-faint max-w-xs">{label}</span>
    </>
  )}
</div>

<style>
  .placeholder {
    color: var(--color-accent);
    background:
      repeating-linear-gradient(
        -45deg,
        color-mix(in srgb, var(--color-accent) 7%, transparent) 0 10px,
        transparent 10px 20px
      ),
      var(--color-surface);
  }
</style>
